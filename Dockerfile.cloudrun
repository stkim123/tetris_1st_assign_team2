FROM eclipse-temurin:21-jdk-jammy AS build
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip fontconfig fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
ENV MAVEN_OPTS="-Xmx512m"
WORKDIR /workspace
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN chmod +x mvnw
COPY src/ src/
RUN ./mvnw -B -ntp verify

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/target/tetris-server.jar /app/tetris-server.jar
USER 10001:10001
ENV TETRIS_BACKEND=firebase PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-Djava.awt.headless=true", "-Xms64m", "-Xmx384m", "-XX:MaxDirectMemorySize=128m", "-jar", "/app/tetris-server.jar"]
