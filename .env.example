# Examples only; scripts do not automatically import this file.
# Server settings: configure in Render Environment (never ship to players).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
RENDER_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
PORT=10000
# Operational resource guards, unrelated to the expected four-player traffic.
TETRIS_MAX_WS_CONNECTIONS=128
TETRIS_MAX_PENDING_AUTH=16
# Client public settings may instead be put in tetris-client.properties.
TETRIS_SERVER_URL=wss://YOUR_SERVICE.onrender.com/ws

# Cloud Run alternative (no Supabase values required for this backend).
# ADC uses the attached runtime service account; never distribute its credentials.
# TETRIS_BACKEND=firebase
# FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# TETRIS_ADMIN_TOKEN=SECRET_MANAGER_INJECTED_VALUE
# PORT=8080
# Desktop public settings:
# TETRIS_ONLINE_PROVIDER=firebase
# FIREBASE_API_KEY=YOUR_PUBLIC_FIREBASE_WEB_API_KEY
# TETRIS_SERVER_URL=wss://YOUR_CLOUD_RUN_SERVICE.run.app/ws
